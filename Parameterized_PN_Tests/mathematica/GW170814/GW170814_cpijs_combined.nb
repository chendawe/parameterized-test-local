    RowBox[{"prob", "=", "0.709"}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m1m2", "[", "n", "]"}], "=", 
   RowBox[{"Transpose", "[", 
