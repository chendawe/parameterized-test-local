      RowBox[{
       RowBox[{"BCI", "[", "n", "]"}], "[", "\"\<spin2z\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
