Cell[BoxData[{
 RowBox[{
  RowBox[{"order", "=", "\"\<6l\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"\"\<cpsi\>\"", "<>", 
    RowBox[{"ToString", "[", "order", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"compPlots", "[", "n", "]"}], "=", 
   RowBox[{"PlotComparisonBetween", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"samples", "[", "n", "]"}], "[", "n", "]"}], ",", 
     RowBox[{
      RowBox[{"samples", "[", "n", "]"}], "[", 
      RowBox[{"\"\<psi\>\"", "<>", 
       RowBox[{"ToString", "[", "order", "]"}]}], "]"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{"10", ",", "100", ",", "1"}], "]"}], ",", "order", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"BCI", "[", "n", "]"}], "[", "\"\<spin1z\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"BCI", "[", "n", "]"}], "[", "\"\<spin2z\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"prob", "=", "0.709"}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m1m2", "[", "n", "]"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"samples", "[", "n", "]"}], "[", "\"\<mass1\>\"", "]"}], ",", 
      RowBox[{
       RowBox[{"samples", "[", "n", "]"}], "[", "\"\<mass2\>\"", "]"}]}], 
     "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m1PriorRange", "[", "n", "]"}], ",", 
     RowBox[{"m2PriorRange", "[", "n", "]"}]}], "}"}], "=", 
   RowBox[{"ChirpQRangeToMassRange", "[", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m1m2PDF", "[", "n", "]"}], "=", 
    RowBox[{"GetPDF", "[", 
     RowBox[{
      RowBox[{"m1m2", "[", "n", "]"}], ",", 
      RowBox[{"m1PriorRange", "[", "n", "]"}], ",", 
      RowBox[{"m2PriorRange", "[", "n", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"m1m2PDF", "[", "n", "]"}], "=", 
    RowBox[{"SmoothKernelDistribution", "[", 
     RowBox[{"m1m2", "[", "n", "]"}], "]"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"contourPD", "[", "n", "]"}], "=", 
    RowBox[{"{", "0.0025", "}"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "\:53cc\:5cf0\:6570\:636e\:5bc6\:5ea6\:503c\:8f83\:4f4e", "\:ff0c", 
    "\:8c03\:6574\:4e3a\:53ef\:89c1\:7684\:7b49\:9ad8\:7ebf"}], "*)"}], 
  "\[IndentingNewLine]", 
