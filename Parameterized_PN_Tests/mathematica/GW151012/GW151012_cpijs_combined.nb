 RowBox[{
  RowBox[{
   RowBox[{"compPlots", "[", "n", "]"}], "=", 
   RowBox[{"PlotComparisonBetween", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"samples", "[", "n", "]"}], "[", "n", "]"}], ",", 
     RowBox[{
      RowBox[{"samples", "[", "n", "]"}], "[", 
