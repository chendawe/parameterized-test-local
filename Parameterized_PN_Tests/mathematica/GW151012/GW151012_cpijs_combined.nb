Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"order", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"\"\<cpsi\>\"", "<>", 
    RowBox[{"ToString", "[", "order", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"compPlots", "[", "n", "]"}], "=", 
   RowBox[{"PlotComparisonBetween", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"samples", "[", "n", "]"}], "[", "n", "]"}], ",", 
     RowBox[{
      RowBox[{"samples", "[", "n", "]"}], "[", 
      RowBox[{"\"\<psi\>\"", "<>", 
       RowBox[{"ToString", "[", "order", "]"}]}], "]"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{"10", ",", "100", ",", "1"}], "]"}], ",", "order", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"BCI", "[", "n", "]"}], "[", "\"\<spin1z\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"BCI", "[", "n", "]"}], "[", "\"\<spin2z\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"prob", "=", "0.709"}], ";"}], "*)"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m1m2", "[", "n", "]"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"samples", "[", "n", "]"}], "[", "\"\<mass1\>\"", "]"}], ",", 
      RowBox[{
       RowBox[{"samples", "[", "n", "]"}], "[", "\"\<mass2\>\"", "]"}]}], 
     "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m1PriorRange", "[", "n", "]"}], ",", 
     RowBox[{"m2PriorRange", "[", "n", "]"}]}], "}"}], "=", 
   RowBox[{"ChirpQRangeToMassRange", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"11", ",", "22"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "12"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m1m2PDF", "[", "n", "]"}], "=", 
    RowBox[{"GetNormalizedPDF", "[", 
     RowBox[{
      RowBox[{"m1m2", "[", "n", "]"}], ",", 
      RowBox[{"m1PriorRange", "[", "n", "]"}], ",", 
      RowBox[{"m2PriorRange", "[", "n", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", 
