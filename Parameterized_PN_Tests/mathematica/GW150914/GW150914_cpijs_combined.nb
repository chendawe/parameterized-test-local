  RowBox[{"n", "=", 
   RowBox[{"\"\<cpsi\>\"", "<>", 
    RowBox[{"ToString", "[", "order", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"compPlots", "[", "n", "]"}], "=", 
   RowBox[{"PlotComparisonBetween", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"samples", "[", "n", "]"}], "[", "n", "]"}], ",", 
