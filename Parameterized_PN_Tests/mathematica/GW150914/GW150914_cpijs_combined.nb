     "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m1PriorRange", "[", "n", "]"}], ",", 
     RowBox[{"m2PriorRange", "[", "n", "]"}]}], "}"}], "=", 
   RowBox[{"ChirpQRangeToMassRange", "[", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m1m2PDF", "[", "n", "]"}], "=", 
