Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"samples", "[", "\"\<psi0\>\"", "]"}], "=", 
   RowBox[{"MapThread", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"Psi", "[", 
       RowBox[{"0", ",", 
        RowBox[{"\[Eta]", "[", 
         RowBox[{"#1", ",", "#2"}], "]"}], ",", 
        RowBox[{"M", "[", 
         RowBox[{"#1", ",", "#2"}], "]"}], ",", "#3", ",", "#4"}], "]"}], 
      "&"}], ",", "\[IndentingNewLine]", 
