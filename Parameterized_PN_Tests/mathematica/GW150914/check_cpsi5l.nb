        RowBox[{"[", "2", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"(*", " ", "FArgs_", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"BCI", "[", "\"\<eta\>\"", "]"}], ",", "2"}], 
