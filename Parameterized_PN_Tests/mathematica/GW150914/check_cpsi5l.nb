  RowBox[{
   RowBox[{"pancakesFixChia", "[", "alphaName", "]"}], "=", 
   RowBox[{"HypersurfacePancake", "[", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"j", ",", "eta", ",", "chis", ",", "chia"}], "}"}], ",", 
       "\[IndentingNewLine]", 
