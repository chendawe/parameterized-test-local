     RowBox[{"(*", " ", "F_", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"BCI", "[", "alphaName", "]"}], ",", 
     RowBox[{"(*", " ", "F0_", " ", "*)"}], "\[IndentingNewLine]", 
     RowBox[{"{", "chiss", "}"}], ",", 
     RowBox[{"{", "2", "}"}], ",", 
