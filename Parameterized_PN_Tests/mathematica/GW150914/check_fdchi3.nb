     RowBox[{"{", "m2s", "}"}], ",", 
     RowBox[{"{", "2", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", 
       RowBox[{
        RowBox[{"BCI", "[", "\"\<spin1_z\>\"", "]"}], "[", 
