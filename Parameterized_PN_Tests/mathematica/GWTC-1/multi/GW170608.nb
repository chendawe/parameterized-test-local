      RowBox[{
       RowBox[{"m1m2PDF", "[", "\"\<GR\>\"", "]"}], "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{
       RowBox[{"5", "<", "x", "<", "20"}], "&&", 
       RowBox[{"5", "<", "y", "<", "20"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"m1m2Max", "=", 
  RowBox[{"Reverse", "[", 
