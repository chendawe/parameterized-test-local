Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"p", "=", "\"\<GR\>\""}], "\n", 
 RowBox[{
  RowBox[{"m1Data", "=", 
   RowBox[{
    RowBox[{"samples", "[", "p", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"m2Data", "=", 
    RowBox[{
     RowBox[{"samples", "[", "p", "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"\:7b97", " ", "PDF"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m1m2", "[", "p", "]"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"m1Data", ",", "m2Data"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m1PriorRange", "[", "p", "]"}], ",", 
     RowBox[{"m2PriorRange", "[", "p", "]"}]}], "}"}], "=", 
   RowBox[{"ChirpQRangeToMassRange", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"3", ",", "40"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "3"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m1m2PDF", "[", "p", "]"}], "=", 
    RowBox[{"GetNormalizedPDF", "[", 
     RowBox[{
      RowBox[{"m1m2", "[", "p", "]"}], ",", 
      RowBox[{"m1PriorRange", "[", "p", "]"}], ",", 
      RowBox[{"m2PriorRange", "[", "p", "]"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"maxPoint", "=", 
  RowBox[{"NMaximize", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"m1m2PDF", "[", "\"\<GR\>\"", "]"}], "[", 
       RowBox[{"x", ",", "y"}], "]"}], ",", 
      RowBox[{
       RowBox[{"5", "<", "x", "<", "20"}], "&&", 
       RowBox[{"5", "<", "y", "<", "20"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"x", ",", "y"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"m1m2Max", "=", 
  RowBox[{"Reverse", "[", 
   RowBox[{"Values", "[", 
    RowBox[{"maxPoint", "[", 
     RowBox[{"[", "2", "]"}], "]"}], "]"}], "]"}]}]}], "Input",
