Cell[CellGroupData[{

Cell["Compute GR m1 and m2 PDF", "Section",
 CellChangeTimes->{{3.9886123043390594`*^9, 
  3.988612314638133*^9}},ExpressionUUID->"1cfbb4b3-b6bf-4f00-841c-\
32c92dc720b5"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"p", "=", "\"\<GR\>\""}], "\n", 
 RowBox[{
  RowBox[{"m1Data", "=", 
   RowBox[{
    RowBox[{"samples", "[", "p", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"m2Data", "=", 
    RowBox[{
     RowBox[{"samples", "[", "p", "]"}], "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"\:7b97", " ", "PDF"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m1m2", "[", "p", "]"}], "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"m1Data", ",", "m2Data"}], "}"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"m1PriorRange", "[", "p", "]"}], ",", 
     RowBox[{"m2PriorRange", "[", "p", "]"}]}], "}"}], "=", 
   RowBox[{"ChirpQRangeToMassRange", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"10", ",", "80"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"m1m2PDF", "[", "p", "]"}], "=", 
   RowBox[{"GetNormalizedPDF", "[", 
    RowBox[{
     RowBox[{"m1m2", "[", "p", "]"}], ",", 
     RowBox[{"m1PriorRange", "[", "p", "]"}], ",", 
     RowBox[{"m2PriorRange", "[", "p", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 InitializationCell->True,
 CellChangeTimes->{{3.9886123262146616`*^9, 3.9886123286394286`*^9}},
 CellLabel->
  "In[140]:=",ExpressionUUID->"042668c7-2e48-4573-a93a-73d1d063b32f"],

