In[484]:= (*批量计算非自旋 GR 系数值*)getGRValues[paramName_,m1s_,m2s_,chi1L_,chi2L_]:=Module[{etas},etas=etaFromMasses[m1s,m2s];
Switch[paramName,
(*(* =====Alpha (并合段)=====*)"dalpha_3",IMRPhenomDAlphaNS[3,m1s,m2s,0,0],"dalpha_4",IMRPhenomDAlphaNS[4,m1s,m2s,0,0],"dalpha_2",IMRPhenomDAlphaNS[2,m1s,m2s,0,0],
(* =====Beta (过渡段)=====*)"dbeta_2",IMRPhenomDBetaNS[2,m1s,m2s,0,0],"dbeta_3",IMRPhenomDBetaNS[3,m1s,m2s,0,0],*)
(* =====Phi (旋近段)=====因为设置了 Listable，直接把整个 m1s,m2s 列表传进去即可，内部会自动对每个元素计算并返回列表*)
"dphi_0",IMRPhenomXASPhi[0,m1s,m2s,chi1L,chi2L],
"dphi_2",IMRPhenomXASPhi[2,m1s,m2s,chi1L,chi2L],
"dphi_3",IMRPhenomXASPhi[3,m1s,m2s,chi1L,chi2L],
"dphi_4",IMRPhenomXASPhi[4,m1s,m2s,chi1L,chi2L],
"dphi_5l",IMRPhenomXASPhiL[5,m1s,m2s,chi1L,chi2L],
"dphi_6",IMRPhenomXASPhi[6,m1s,m2s,chi1L,chi2L],
"dphi_6l",IMRPhenomXASPhiL[6,m1s,m2s,chi1L,chi2L],
"dphi_7",IMRPhenomXASPhi[7,m1s,m2s,chi1L,chi2L],
_,ConstantArray[0,Length[m1s]]]];


(* ==========对所有参数追加第6列(GR值)和第7列(参数化值)==========*)
Do[Module[{grVals,paramVals},
(*第6列：非自旋 GR 系数值*)grVals=getGRValues[p,samples[p][[1]],samples[p][[2]],samples[p][[3]],samples[p][[4]]];
(*第7列：参数化值=GR\[Times](1+d)*)paramVals=grVals*(1+samples[p][[5]]);
(*拼接到原来的5列后面*)samples[p]=Join[samples[p],{grVals,paramVals}];
],{p,allParams}];


