Cell[CellGroupData[{

Cell["\<\
Calculate GR pars and further Transform $\\delta$ into parameterized pars\
\>", "Section",
 CellChangeTimes->{{3.95795308100935*^9, 3.957953094839864*^9}, {
  3.957953863122257*^9, 3.9579538656182165`*^9}, {3.985834576048498*^9, 
  3.985834612412236*^9}, {3.9858354096656923`*^9, 
  3.985835448970592*^9}},ExpressionUUID->"50d565c1-f1be-4f38-8926-\
f639a65633e9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "\:6279\:91cf\:8ba1\:7b97\:975e\:81ea\:65cb", " ", "GR", " ", 
    "\:7cfb\:6570\:503c"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"getGRValues", "[", 
      RowBox[{
      "paramName_", ",", "m1s_", ",", "m2s_", ",", "chi1L_", ",", "chi2L_"}], 
      "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "etas", "}"}], ",", 
       RowBox[{
        RowBox[{"etas", "=", 
         RowBox[{"etaFromMasses", "[", 
          RowBox[{"m1s", ",", "m2s"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Switch", "[", 
