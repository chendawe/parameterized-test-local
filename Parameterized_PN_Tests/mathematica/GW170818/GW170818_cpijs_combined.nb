 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"pInterval", "[", "n", "]"}], "=", 
    RowBox[{"IntervalFromProbability", "[", "prob", "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tapeIntervals", "[", "\"\<mass1\>\"", "]"}], "=", 
   RowBox[{"Quantile", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"samples", "[", "n", "]"}], "[", "\"\<mass1\>\"", "]"}], ",", 
     RowBox[{"pInterval", "[", "n", "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"tapeIntervals", "[", "\"\<mass2\>\"", "]"}], "=", 
