   RowBox[{"ChirpQRangeToMassRange", "[", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"m1m2PDF", "[", "n", "]"}], "=", 
