Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"m1s", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"20", ",", "60", ",", "1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"m2s", "=", 
    RowBox[{"Range", "[", 
     RowBox[{"20", ",", "60", ",", "1"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"order", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"\"\<cpsi\>\"", "<>", 
    RowBox[{"ToString", "[", "order", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"compPlots", "[", "n", "]"}], "=", 
   RowBox[{"PlotComparisonBetween", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"samples", "[", "n", "]"}], "[", "n", "]"}], ",", 
     RowBox[{
      RowBox[{"samples", "[", "n", "]"}], "[", 
      RowBox[{"\"\<psi\>\"", "<>", 
       RowBox[{"ToString", "[", "order", "]"}]}], "]"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{"10", ",", "100", ",", "1"}], "]"}], ",", "order", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"BCI", "[", "n", "]"}], "[", "\"\<spin1z\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"BCI", "[", "n", "]"}], "[", "\"\<spin2z\>\"", "]"}], "[", 
      RowBox[{"[", "1", "]"}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"prob", "=", "0.77"}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"tapes", "[", "n", "]"}], "=", 
   RowBox[{"<|", "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pInterval", "[", "n", "]"}], "=", 
