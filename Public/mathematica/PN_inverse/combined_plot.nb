Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", "\:751f\:6210\:793a\:4f8b\:6570\:636e", "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"SeedRandom", "[", "123", "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"data", "=", 
     RowBox[{"RandomVariate", "[", 
      RowBox[{
       RowBox[{"BinormalDistribution", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"1", ",", "1.5"}], "}"}], ",", "0.4"}], "]"}], ",", 
       "100000"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"alpha", "=", "0.95"}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"1.", " ", "\:8ba1\:7b97\:4e2d\:5fc3\:548c\:8ddd\:79bb"}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"center", "=", 
     RowBox[{"Mean", "[", "data", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"distances", "=", 
     RowBox[{
      RowBox[{
       RowBox[{"EuclideanDistance", "[", 
        RowBox[{"#", ",", "center"}], "]"}], "&"}], "/@", "data"}]}], ";"}], 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "\:53d6\:6700\:8fd1\:7684", " ", "k", " ", "\:4e2a\:70b9"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"k", "=", 
     RowBox[{"Ceiling", "[", 
      RowBox[{"alpha", "*", 
       RowBox[{"Length", "[", "data", "]"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"innerPoints", "=", 
     RowBox[{"data", "[", 
      RowBox[{"[", 
       RowBox[{"Ordering", "[", 
        RowBox[{"distances", ",", "k"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"3.", " ", "\:6784\:5efa\:51f8\:5305"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"ch", "=", 
     RowBox[{"ConvexHullMesh", "[", "innerPoints", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "\:2705", " ", 
     "\:6b63\:786e\:63d0\:53d6\:51f8\:5305\:8fb9\:754c\:9876\:70b9", 
     RowBox[{"\:ff08", "\:6309\:5faa\:73af\:987a\:5e8f", "\:ff09"}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"\:65b9\:6cd5", "\:ff1a", 
     RowBox[{
     "\:5229\:7528", " ", "MeshPrimitives", " ", 
      "\:63d0\:53d6\:8fb9\:754c\:7ebf\:6bb5"}], "\:ff0c", 
     "\:518d\:91cd\:5efa\:987a\:5e8f"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"boundaryLine", "=", 
     RowBox[{"MeshPrimitives", "[", 
      RowBox[{"ch", ",", "1"}], "]"}]}], ";"}], "  ", 
   RowBox[{"(*", "\:6240\:6709\:8fb9", "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"\:4f46\:66f4\:7b80\:5355", "\:ff1a", 
     RowBox[{"\:76f4\:63a5\:83b7\:53d6\:9876\:70b9\:987a\:5e8f", 
      RowBox[{"\:ff08", 
       RowBox[{
        RowBox[{"v12", ".0"}], "+", "\:652f\:6301"}], "\:ff09"}]}]}], "*)"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"\:6700\:53ef\:9760\:65b9\:6cd5", "\:ff1a", 
     RowBox[{
     "\:7528", " ", "FindShortestTour", " ", 
      "\:91cd\:5efa\:51f8\:5305\:70b9\:7684\:73af\:5f62\:987a\:5e8f"}]}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"hullPts", "=", 
     RowBox[{"MeshCoordinates", "[", "ch", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"tourLength", ",", "tourOrder"}], "}"}], "=", 
     RowBox[{"FindShortestTour", "[", "hullPts", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"orderedBoundary", "=", 
     RowBox[{"hullPts", "[", 
      RowBox[{"[", "tourOrder", "]"}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
