Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ClearAll", "[", "CalculateSampleRatios", "]"}], ";"}], 
  "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "\:53c2\:6570\:987a\:5e8f\:8c03\:6574", "\:ff1a", 
    "\:589e\:52a0baseLowerBounds\:548cbaseUpperBounds\:53c2\:6570"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CalculateSampleRatios", "[", 
    RowBox[{
    "samples_", ",", "baseMedians_List", ",", "baseLowerBounds_List", ",", 
     "baseUpperBounds_List", ",", 
     RowBox[{"p_", ":", "All"}], ",", 
     RowBox[{"quantiles_", ":", 
      RowBox[{"{", 
       RowBox[{"0.05", ",", "0.5", ",", "0.95"}], "}"}]}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"m", "=", 
        RowBox[{"Length", "[", "baseMedians", "]"}]}], ",", "pKeys", ",", 
       "processSingleP", ",", "quantileLabels"}], "}"}], ",", 
     RowBox[{
     "(*", "\:68c0\:67e5\:8f93\:5165\:53c2\:6570\:6709\:6548\:6027", "*)"}], 
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "baseMedians", "]"}], "!=", "m"}], ",", 
        RowBox[{
        "Return", "[", 
         "\"\<Error: baseMedians \:957f\:5ea6\:5fc5\:987b\:4e0e m \
\:4e00\:81f4\>\"", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "baseLowerBounds", "]"}], "!=", "m"}], ",", 
        RowBox[{
        "Return", "[", 
         "\"\<Error: baseLowerBounds \:957f\:5ea6\:5fc5\:987b\:4e0e \
baseMedians \:4e00\:81f4\>\"", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "baseUpperBounds", "]"}], "!=", "m"}], ",", 
        RowBox[{
        "Return", "[", 
         "\"\<Error: baseUpperBounds \:957f\:5ea6\:5fc5\:987b\:4e0e \
baseMedians \:4e00\:81f4\>\"", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Length", "[", "quantiles", "]"}], "!=", "3"}], ",", 
        RowBox[{
        "Return", "[", 
         "\"\<Error: quantiles \:5fc5\:987b\:5305\:542b3\:4e2a\:5206\:4f4d\
\:6570\>\"", "]"}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"\:5904\:7406", " ", "p", " ", "\:7684\:9ed8\:8ba4\:503c"}], 
        "\:ff1a", 
        RowBox[{"\:5982\:679c\:662f", " ", "All"}], "\:ff0c", 
        RowBox[{
        "\:63d0\:53d6", " ", "samples", " ", "\:7684\:6240\:6709\:952e"}]}], 
       "*)"}], 
      RowBox[{"pKeys", "=", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"p", "===", "All"}], ",", 
         RowBox[{"Keys", "[", "samples", "]"}], ",", "p"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{
        "\:5982\:679c\:7528\:6237\:53ea\:4f20\:4e86\:4e00\:4e2a", " ", "p", 
         RowBox[{"\:ff08", "\:4e0d\:662f\:5217\:8868", "\:ff09"}]}], "\:ff0c",
         "\:628a\:5b83\:5305\:88c5\:6210\:5217\:8868\:4ee5\:4fbf\:7edf\:4e00\
\:904d\:5386"}], "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Head", "[", "pKeys", "]"}], "=!=", "List"}], ",", 
        RowBox[{"pKeys", "=", 
         RowBox[{"{", "pKeys", "}"}]}]}], "]"}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "\:751f\:6210\:5206\:4f4d\:6570\:6807\:7b7e", "*)"}], 
      RowBox[{"quantileLabels", "=", 
       RowBox[{"{", 
        RowBox[{
        "\"\<LowerBound\>\"", ",", "\"\<Median\>\"", ",", 
         "\"\<UpperBound\>\""}], "}"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", "\:6838\:5fc3\:8ba1\:7b97\:903b\:8f91", "*)"}], 
      RowBox[{
       RowBox[{"processSingleP", "[", "pKey_", "]"}], ":=", 
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "cols", ",", "quantileValues", ",", "sampleWidths", ",", 
           "baseWidths", ",", "ratios", ",", "result"}], "}"}], ",", 
         RowBox[{
          RowBox[{"cols", "=", 
           RowBox[{"Take", "[", 
            RowBox[{
             RowBox[{"samples", "[", "pKey", "]"}], ",", "m"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{
          "(*", "\:8ba1\:7b97\:6837\:672c\:7684\:4e09\:4e2a\:5206\:4f4d\:6570\
", "*)"}], 
          RowBox[{"quantileValues", "=", 
           RowBox[{
            RowBox[{
             RowBox[{"Quantile", "[", 
              RowBox[{"#", ",", "quantiles"}], "]"}], "&"}], "/@", "cols"}]}],
           ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "\:8ba1\:7b97\:6837\:672c\:768490", "%", 
            "\:53ef\:4fe1\:533a\:95f4\:5bbd\:5ea6"}], "*)"}], 
          RowBox[{"sampleWidths", "=", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"quantileValues", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "3"}], "]"}], "]"}], "-", 
             RowBox[{"quantileValues", "[", 
              RowBox[{"[", 
               RowBox[{"All", ",", "1"}], "]"}], "]"}]}], ")"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "\:8ba1\:7b97\:57fa\:5e95\:768490", "%", 
            "\:53ef\:4fe1\:533a\:95f4\:5bbd\:5ea6"}], "*)"}], 
          RowBox[{"baseWidths", "=", 
           RowBox[{"(", 
            RowBox[{"baseUpperBounds", "-", "baseLowerBounds"}], ")"}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{
          "(*", "\:8ba1\:7b97\:6bcf\:4e2a\:5206\:4f4d\:6570\:7684\:6bd4\:503c\
", "*)"}], 
          RowBox[{"ratios", "=", 
           RowBox[{
            RowBox[{"Transpose", "[", "quantileValues", "]"}], "/", 
            RowBox[{"{", 
             RowBox[{
             "baseLowerBounds", ",", "baseMedians", ",", "baseUpperBounds"}], 
             "}"}]}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", "\:8ba1\:7b97\:5bbd\:5ea6\:6bd4", "*)"}], 
          RowBox[{"widthRatios", "=", 
           RowBox[{"sampleWidths", "/", "baseWidths"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "\:7ec4\:7ec7\:7ed3\:679c", "*)"}], 
          RowBox[{"result", "=", 
           RowBox[{"<|", 
            RowBox[{"\"\<p\>\"", "->", "pKey"}], "|>"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"result", "[", 
               RowBox[{
                RowBox[{"quantileLabels", "[", 
                 RowBox[{"[", "i", "]"}], "]"}], "<>", "\"\<Ratios\>\""}], 
               "]"}], "=", 
              RowBox[{"AssociationThread", "[", 
               RowBox[{
                RowBox[{"Range", "[", "m", "]"}], ",", 
                RowBox[{"ratios", "[", 
                 RowBox[{"[", "i", "]"}], "]"}]}], "]"}]}], ";"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "3"}], "}"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", "\:6dfb\:52a0\:5bbd\:5ea6\:6bd4", "*)"}], 
          RowBox[{
           RowBox[{"result", "[", "\"\<WidthRatios\>\"", "]"}], "=", 
           RowBox[{"AssociationThread", "[", 
            RowBox[{
             RowBox[{"Range", "[", "m", "]"}], ",", "widthRatios"}], "]"}]}], 
          ";", "\[IndentingNewLine]", "result"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", "\:904d\:5386\:8ba1\:7b97", "*)"}], 
      RowBox[{"processSingleP", "/@", "pKeys"}]}]}], "]"}]}], "\n", 
  "\n"}], "\n"}], "Input",
